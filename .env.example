# Database & Auth (Supabase)
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?pgbooster=true"
NEXT_PUBLIC_SUPABASE_URL="https://your-app.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# AI Core
ANTHROPIC_API_KEY="sk-ant-api..."

# Brokerage Data Connector
SNAPTRADE_MODE="personal" # Options: 'personal' | 'commercial'
SNAPTRADE_CLIENT_ID="your-client-id"
SNAPTRADE_CONSUMER_KEY="your-consumer-key"
SNAPTRADE_DEV_USER_ID="dev-user-id"
SNAPTRADE_DEV_USER_SECRET="dev-user-secret"

# Monetization (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Web Push Credentials (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."